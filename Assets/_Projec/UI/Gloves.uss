/* Guantes: estilo propio en stash, inventario de run y tooltip (GloveVisuals.cs).
   Color por escuela (GloveSchool: Fire, Nature, Light, Earth). Escuela nueva = agregar su bloque de colores al final.
   El color del borde de las casillas sigue siendo el de la rareza. */

/* ---------- Casilla de grilla ---------- */
.item-slot.item-glove {
    border-radius: 18px;
}

.glove-band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
}

.glove-badge {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 9px;
    height: 9px;
    rotate: 45deg;
    border-radius: 2px;
}

/* ---------- Fila del loadout ---------- */
.equip-slot.equip-slot-glove {
    border-left-width: 3px;
    border-radius: 4px;
    padding-left: 8px;
}

.accent-dot.glove-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    rotate: 45deg;
}

.equip-name-column {
    flex-direction: column;
    align-items: flex-end;
}

.glove-ability {
    font-size: 13px;
    margin-left: 8px;
    -unity-font-style: bold;
}

/* ---------- Tooltip ---------- */
.item-tooltip.tooltip-glove {
    border-left-width: 3px;
}

/* ---------- Colores por escuela ---------- */
/* Fire: brasa */
.item-slot.item-glove.school-fire { background-color: rgba(232, 112, 76, 0.16); }
.school-fire .glove-band,
.school-fire .glove-badge          { background-color: rgb(232, 112, 76); }
.equip-slot-glove.school-fire      { border-left-color: rgb(232, 112, 76); background-color: rgba(232, 112, 76, 0.10); }
.equip-slot-glove.school-fire .glove-dot { background-color: rgb(232, 112, 76); }
.equip-slot-glove.school-fire .glove-ability { color: rgb(240, 150, 120); }
.tooltip-glove.school-fire         { border-left-color: rgb(232, 112, 76); }
.tooltip-glove.school-fire .tooltip-type { color: rgb(240, 150, 120); }

/* Nature: verde */
.item-slot.item-glove.school-nature { background-color: rgba(103, 210, 131, 0.16); }
.school-nature .glove-band,
.school-nature .glove-badge          { background-color: rgb(103, 210, 131); }
.equip-slot-glove.school-nature      { border-left-color: rgb(103, 210, 131); background-color: rgba(103, 210, 131, 0.10); }
.equip-slot-glove.school-nature .glove-dot { background-color: rgb(103, 210, 131); }
.equip-slot-glove.school-nature .glove-ability { color: rgb(140, 225, 160); }
.tooltip-glove.school-nature         { border-left-color: rgb(103, 210, 131); }
.tooltip-glove.school-nature .tooltip-type { color: rgb(140, 225, 160); }

/* Light: violeta claro */
.item-slot.item-glove.school-light { background-color: rgba(196, 168, 255, 0.16); }
.school-light .glove-band,
.school-light .glove-badge          { background-color: rgb(196, 168, 255); }
.equip-slot-glove.school-light      { border-left-color: rgb(196, 168, 255); background-color: rgba(196, 168, 255, 0.10); }
.equip-slot-glove.school-light .glove-dot { background-color: rgb(196, 168, 255); }
.equip-slot-glove.school-light .glove-ability { color: rgb(214, 196, 255); }
.tooltip-glove.school-light         { border-left-color: rgb(196, 168, 255); }
.tooltip-glove.school-light .tooltip-type { color: rgb(214, 196, 255); }

/* Earth: ocre */
.item-slot.item-glove.school-earth { background-color: rgba(196, 150, 96, 0.16); }
.school-earth .glove-band,
.school-earth .glove-badge          { background-color: rgb(196, 150, 96); }
.equip-slot-glove.school-earth      { border-left-color: rgb(196, 150, 96); background-color: rgba(196, 150, 96, 0.10); }
.equip-slot-glove.school-earth .glove-dot { background-color: rgb(196, 150, 96); }
.equip-slot-glove.school-earth .glove-ability { color: rgb(220, 182, 135); }
.tooltip-glove.school-earth         { border-left-color: rgb(196, 150, 96); }
.tooltip-glove.school-earth .tooltip-type { color: rgb(220, 182, 135); }
