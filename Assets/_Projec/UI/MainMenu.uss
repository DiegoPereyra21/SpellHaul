.menu-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(8, 8, 17);
}

.menu-content {
    align-items: center;
}

.game-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Cinzel-Medium.ttf");
    color: rgb(243, 244, 252);
    font-size: 92px;
    letter-spacing: 20px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 55px rgba(181, 139, 249, 0.45);
}

.title-divider {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
    margin-bottom: 10px;
}

.divider-line {
    width: 40px;
    height: 1px;
    background-color: rgba(195, 151, 42, 0.6);
}

.divider-diamond {
    width: 9px;
    height: 9px;
    background-color: rgb(228, 183, 80);
    rotate: 45deg;
    margin-left: 17px;
    margin-right: 17px;
}

.game-subtitle {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Regular.ttf");
    font-size: 21px;
    letter-spacing: 4px;
    color: rgb(131, 133, 146);
    margin-bottom: 46px;
}

.menu-buttons {
    align-items: center;
}

.menu-button {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    width: 460px;
    font-size: 22px;
    letter-spacing: 1.5px;
    padding: 23px 32px;
    margin: 11px;
    color: rgb(220, 221, 229);
    background-color: rgba(25, 26, 36, 0.5);
    border-width: 1px;
    border-color: rgba(95, 98, 117, 0.5);
    border-radius: 12px;
    -unity-text-align: middle-center;
}

.menu-button:hover {
    background-color: rgba(35, 36, 48, 0.7);
    border-color: rgba(181, 139, 249, 0.5);
}

.menu-button.primary {
    padding: 24px 32px;
    color: rgb(8, 8, 17);
    background-color: rgb(186, 146, 253);
    border-color: rgb(186, 146, 253);
}

.menu-button.primary:hover {
    background-color: rgb(200, 165, 254);
}

.menu-button.quit {
    color: rgb(111, 113, 125);
    background-color: transparent;
    border-color: rgba(56, 58, 69, 0.4);
}

.menu-button.quit:hover {
    color: rgb(220, 221, 229);
    border-color: rgba(111, 113, 125, 0.6);
}

.version-tag {
    position: absolute;
    bottom: 26px;
    left: 36px;
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(83, 84, 97);
}

.lobby-panel {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 520px;
    background-color: rgba(14, 14, 24, 0.96);
    border-width: 1px;
    border-color: rgba(48, 49, 66, 0.5);
    border-radius: 12px;
    padding: 26px;
}

/* Dentro del panel los botones ocupan el ancho disponible: con el ancho fijo del menú
   principal (460px + márgenes) se salían del panel. */
.lobby-panel .menu-button {
    width: auto;
    align-self: stretch;
    margin: 8px 0;
}

.lobby-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Cinzel-Medium.ttf");
    font-size: 20px;
    color: rgb(243, 244, 252);
    margin-bottom: 16px;
    -unity-text-align: upper-center;
}

.lobby-entry:hover {
    background-color: rgba(48, 49, 66, 0.6);
}

.search-status {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    font-size: 16px;
    color: rgb(220, 221, 229);
    -unity-text-align: upper-center;
    white-space: normal; /* los avisos largos parten en líneas en vez de salirse del panel */
    margin-bottom: 8px;
}

.search-timer {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Cinzel-Medium.ttf");
    font-size: 28px;
    color: rgb(186, 146, 253);
    -unity-text-align: upper-center;
    margin-bottom: 20px;
}
.rejoin-status {
    white-space: normal;
    margin-bottom: 20px;
}
