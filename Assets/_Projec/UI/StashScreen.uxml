<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="StashScreen.uss" />
    <ui:VisualElement name="stash-root" class="stash-root">
        <ui:VisualElement class="stash-panel">
            <ui:Label text="Stash" class="stash-title" />

            <ui:VisualElement class="management-columns">

                <ui:VisualElement name="loadout-column" class="mgmt-column">
                    <ui:Label text="Loadout" class="column-header" />
                    <ui:Label name="loadout-lock-note" text="Locked while searching for a run" class="loadout-lock-note" />
                    <ui:VisualElement name="equipment-slots" class="equipment-slots" />

                    <ui:VisualElement class="pockets-row">
                        <ui:VisualElement class="pocket-column">
                            <ui:Label name="pocket-l-label" text="Pocket L" class="grid-header" />
                            <ui:VisualElement name="pocket-l-grid" class="grid backpack-grid" />
                        </ui:VisualElement>
                        <ui:VisualElement class="pocket-column">
                            <ui:Label name="pocket-r-label" text="Pocket R" class="grid-header" />
                            <ui:VisualElement name="pocket-r-grid" class="grid backpack-grid" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="mgmt-column">
                    <ui:VisualElement class="stash-header-row">
                        <ui:Label name="stash-label" text="Stash" class="grid-header" />
                        <ui:VisualElement class="sort-buttons">
                            <ui:Label text="Sort" class="sort-caption" />
                            <ui:Button name="sort-type" text="Type" class="sort-btn" />
                            <ui:Button name="sort-rarity" text="Rarity" class="sort-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="stash-grid" class="grid stash-grid-big" />
                </ui:VisualElement>

            </ui:VisualElement>

            <ui:Label text="Click an item to move it between pockets and stash · Shift-click to auto-equip · Drag to place manually" class="hint" />
            <ui:Button name="stash-close" text="Close" class="stash-close-btn" />
        </ui:VisualElement>
        <ui:VisualElement name="item-tooltip" class="item-tooltip" picking-mode="Ignore">
            <ui:Label name="tooltip-title" class="tooltip-title" />
            <ui:Label name="tooltip-type" class="tooltip-type" />
            <ui:Label name="tooltip-description" class="tooltip-description" />
            <ui:VisualElement name="tooltip-stats" class="tooltip-stats" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>