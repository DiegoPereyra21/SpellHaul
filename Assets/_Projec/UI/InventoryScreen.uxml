<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="InventoryScreen.uss" />
    <Style src="Gloves.uss" />
    <Style src="ItemCommon.uss" />
    <ui:VisualElement name="inv-root" class="inv-root">

        <ui:VisualElement name="inv-panel" class="inv-panel">

            <ui:VisualElement class="inv-header">
                <ui:Label text="Inventory" class="inv-title" />
                <ui:Label text="Tab to close" class="inv-hint-corner" />
            </ui:VisualElement>

            <ui:VisualElement class="inv-columns">

                <ui:VisualElement name="equipment-column" class="column equipment-column">
                    <ui:Label text="Equipment" class="column-title" />
                    <ui:VisualElement name="equipment-slots" class="equipment-slots" />
                </ui:VisualElement>

                <ui:VisualElement class="pockets-and-usables">
                    <ui:VisualElement class="pockets-toolbar">
                        <ui:Label text="Sort pockets" class="sort-caption" />
                        <ui:Button name="pockets-sort-type" text="Type" class="sort-btn has-ui-sound" />
                        <ui:Button name="pockets-sort-rarity" text="Rarity" class="sort-btn has-ui-sound" />
                        <ui:Label text="R — last sort" class="sort-hint" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pockets-row">
                        <ui:VisualElement class="pocket-column">
                            <ui:Label text="Pocket L" class="column-title" />
                            <ui:VisualElement name="pocket-l-grid" class="backpack-grid" />
                        </ui:VisualElement>
                        <ui:VisualElement class="pocket-column">
                            <ui:Label text="Pocket R" class="column-title" />
                            <ui:VisualElement name="pocket-r-grid" class="backpack-grid" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="usable-slots" class="usable-slots" />
                </ui:VisualElement>

                <ui:VisualElement name="container-column" class="column container-column">
                    <ui:Label name="container-label" text="Loot Container" class="column-title container-title" />
                    <ui:VisualElement name="container-grid" class="grid backpack-grid" />
                </ui:VisualElement>

            </ui:VisualElement>

            <ui:Label text="Tab — Close · Drag — Move · Shift+Click — Auto-Equip · Ctrl+Click — Drop to World · R — Sort Pockets" class="hint" />

        </ui:VisualElement>
        <ui:VisualElement name="item-tooltip" class="item-tooltip" picking-mode="Ignore">
            <ui:Label name="tooltip-title" class="tooltip-title" />
            <ui:Label name="tooltip-type" class="tooltip-type" />
            <ui:Label name="tooltip-description" class="tooltip-description" />
            <ui:VisualElement name="tooltip-stats" class="tooltip-stats" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>