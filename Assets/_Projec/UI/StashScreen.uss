.stash-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(4, 4, 9);
    display: none;
}

/* Buscando partida: lugar arriba para el banner de búsqueda del menú (que se dibuja encima). */
.stash-root.searching {
    padding-top: 64px;
}

.stash-panel {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Regular.ttf");
    background-color: rgb(18, 19, 29);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.4);
    border-radius: 16px;
    padding: 28px 44px;
    align-items: center;
}

.stash-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Cinzel-Medium.ttf");
    color: rgb(237, 238, 245);
    font-size: 32px;
    margin-bottom: 16px;
}

.management-columns {
    flex-direction: row;
}

.mgmt-column {
    margin: 0 26px;
}

.column-header {
    color: rgb(97, 98, 111);
    font-size: 16px;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

/* Buscando partida: el loadout queda atenuado y no acepta cambios (el stash sí se ordena). */
.loadout-locked .equipment-slots,
.loadout-locked .pockets-row {
    opacity: 0.35;
}

.loadout-lock-note {
    display: none;
    color: rgb(186, 146, 253);
    font-size: 14px;
    -unity-font-style: italic;
    margin-bottom: 8px;
}

.grid-header {
    color: rgb(97, 98, 111);
    font-size: 15px;
    letter-spacing: 1px;
    margin-top: 18px;
    margin-bottom: 10px;
}

/* ---------- Lista de Equipamiento ---------- */

.equipment-slots {
    flex-direction: column;
    width: 480px;
}

.equip-slot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 7px 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(48, 49, 66, 0.25);
}

.equip-slot.no-border {
    border-bottom-width: 0;
}

.equip-slot-label {
    color: rgb(111, 113, 125);
    font-size: 17px;
}

.equip-row-empty {
    color: rgb(83, 84, 97);
    font-size: 16px;
    -unity-font-style: italic;
}

.equip-row-item {
    flex-direction: row;
    align-items: center;
}

.equip-item-name {
    color: rgb(227, 228, 235);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 8px;
}

.accent-dot {
    width: 10px;
    height: 10px;
    border-radius: 6px;
}

/* ---------- Pockets ---------- */

.pockets-row {
    flex-direction: row;
}

.pocket-column {
    margin-right: 24px;
}

/* ---------- Grillas (pockets / stash) ---------- */

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.backpack-grid {
    width: 296px;
}

.stash-grid-big {
    width: 536px;
}

.item-slot {
    width: 66px;
    height: 66px;
    margin: 8px;
    background-color: rgba(29, 30, 41, 0.4);
    border-width: 1px;
    border-color: rgba(55, 57, 74, 0.35);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}
.item-slot:hover {
    border-color: rgba(237, 238, 245, 0.5);
}

/* Slot bloqueado: capacidad actual del pocket no lo alcanza todavía. Sin interacción. */
.item-slot.locked {
    background-color: rgba(6, 6, 10, 0.7);
    border-color: rgba(30, 31, 40, 0.3);
    opacity: 0.3;
}
.item-name {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    color: rgb(237, 238, 245);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    padding: 2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

.item-qty {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

/* ---------- Acentos por slot / tipo de item ---------- */

.accent-dot.accent-green   { background-color: rgb(103, 210, 131); }
.accent-dot.accent-cyan    { background-color: rgb(62, 204, 226); }
.accent-dot.accent-violet  { background-color: rgb(181, 139, 249); }
.accent-dot.accent-gold    { background-color: rgb(228, 183, 80); }
.accent-dot.accent-amber   { background-color: rgb(237, 131, 94); }
.accent-dot.accent-loot    { background-color: rgb(226, 73, 71); }

.item-slot.accent-green  { background-color: rgba(103, 210, 131, 0.18); border-color: rgba(103, 210, 131, 0.55); }
.item-slot.accent-cyan   { background-color: rgba(62, 204, 226, 0.18); border-color: rgba(62, 204, 226, 0.55); }
.item-slot.accent-violet { background-color: rgba(181, 139, 249, 0.18); border-color: rgba(181, 139, 249, 0.55); }
.item-slot.accent-gold   { background-color: rgba(228, 183, 80, 0.18); border-color: rgba(228, 183, 80, 0.55); }
.item-slot.accent-amber  { background-color: rgba(237, 131, 94, 0.18); border-color: rgba(237, 131, 94, 0.55); }
.item-slot.accent-loot   { background-color: rgba(226, 73, 71, 0.18); border-color: rgba(226, 73, 71, 0.6); }

.hint {
    color: rgb(97, 98, 111);
    font-size: 14px;
    -unity-font-style: italic;
    margin-top: 14px;
}

.stash-close-btn {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    align-self: center;
    width: auto;
    padding: 12px 36px;
    margin-top: 12px;
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(220, 221, 229);
    background-color: rgba(25, 26, 36, 0.5);
    border-width: 1px;
    border-color: rgba(95, 98, 117, 0.5);
    border-radius: 8px;
}

.stash-close-btn:hover {
    background-color: rgba(35, 36, 48, 0.7);
    border-color: rgba(181, 139, 249, 0.5);
}

.drag-ghost {
    position: absolute;
    width: 66px;
    height: 66px;
    background-color: rgba(40, 40, 60, 0.95);
    border-width: 1px;
    border-color: rgba(237, 238, 245, 0.6);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
}

.item-tooltip {
    position: absolute;
    display: none;
    background-color: rgb(14, 14, 24);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    border-radius: 8px;
    padding: 12px 14px;
    max-width: 320px;
}

.tooltip-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    color: rgb(237, 238, 245);
    font-size: 17px;
    margin-bottom: 2px;
}

.tooltip-type {
    color: rgb(97, 98, 111);
    font-size: 13px;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.tooltip-description {
    color: rgb(180, 182, 192);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 6px;
}

.tooltip-stat-line {
    font-size: 14px;
    -unity-font-style: bold;
}

.tooltip-stat-positive { color: rgb(80, 210, 100); }
.tooltip-stat-negative { color: rgb(240, 90, 88); }
.tooltip-stat-neutral  { color: rgb(210, 211, 219); }
.rarity-common { color: rgb(227, 228, 235); }
.rarity-rare   { color: rgb(70, 165, 235); }
.rarity-epic   { color: rgb(197, 96, 232); }

/* Rareza en BORDE de las casillas, igual que en el inventario de la run. Va después de los
   acentos por tipo para ganarles el color del borde (el fondo sigue siendo el del tipo). */
.item-slot.rarity-rare {
    border-color: rgb(90, 180, 255);
    border-width: 2px;
}
.item-slot.rarity-epic {
    border-color: rgb(210, 110, 245);
    border-width: 2px;
}
/* ---------- Grupo "Bags" (pockets) en la lista de equipo ---------- */

.equip-group-header {
    color: rgb(150, 132, 190);
    font-size: 13px;
    letter-spacing: 1px;
    margin-top: 8px;
    padding-top: 8px;
    margin-bottom: 2px;
    border-top-width: 1px;
    border-top-color: rgba(181, 139, 249, 0.25);
}

.equip-slot.equip-slot-bag {
    padding: 5px 8px;
    margin-top: 3px;
    border-bottom-width: 0;
    border-radius: 6px;
    background-color: rgba(181, 139, 249, 0.06);
}

.equip-slot-bag .equip-slot-label {
    color: rgb(150, 132, 190);
}

/* ---------- Ordenar stash ---------- */

.stash-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-right: 8px;
}

.sort-buttons {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.sort-caption {
    color: rgb(97, 98, 111);
    font-size: 14px;
    letter-spacing: 1px;
    margin-right: 8px;
}

.sort-btn {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    font-size: 14px;
    padding: 6px 14px;
    margin: 0 0 0 6px;
    color: rgb(200, 201, 212);
    background-color: rgba(25, 26, 36, 0.6);
    border-width: 1px;
    border-color: rgba(95, 98, 117, 0.5);
    border-radius: 6px;
}

.sort-btn:hover {
    background-color: rgba(35, 36, 48, 0.8);
    border-color: rgba(181, 139, 249, 0.6);
}

/* ---------- Usables (teclas 1-2-3 en la run) ---------- */
.usables-grid {
    width: 296px;
}

.usable-key-hint {
    position: absolute;
    bottom: 3px;
    left: 6px;
    color: rgb(97, 98, 111);
    font-size: 12px;
}

/* ---------- Pestañas Stash / Crafting / Trader (EconomyPanel) ---------- */
.economy-column {
    width: 560px;
}

.economy-tabs {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.economy-tab {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    font-size: 15px;
    padding: 6px 16px;
    margin: 0 6px 0 0;
    color: rgb(160, 162, 176);
    background-color: rgba(25, 26, 36, 0.6);
    border-width: 1px;
    border-color: rgba(95, 98, 117, 0.4);
    border-radius: 6px;
}

.economy-tab:hover {
    border-color: rgba(181, 139, 249, 0.6);
}

.economy-tab.tab-active {
    color: rgb(237, 238, 245);
    border-color: rgb(181, 139, 249);
    background-color: rgba(181, 139, 249, 0.18);
}

.gold-label {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    margin-left: auto;
    color: rgb(228, 183, 80);
    font-size: 17px;
}

.economy-view {
    display: none;
    height: 600px;
}

.recipe-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(48, 49, 66, 0.4);
}

.recipe-info {
    flex-shrink: 1;
}

.recipe-name {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    font-size: 16px;
}

.recipe-inputs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

.recipe-input {
    font-size: 13px;
    margin-right: 12px;
}

.recipe-input--ok      { color: rgb(150, 210, 160); }
.recipe-input--missing { color: rgb(220, 110, 105); }

.economy-btn {
    min-width: 90px;
}

.trader-offers {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Oferta del vendedor: la casilla del item y el botón de comprar debajo. */
.offer-card {
    align-items: center;
    margin-right: 4px;
}

.offer-buy-btn {
    margin: 0 0 6px 0;
    padding: 3px 12px;
    font-size: 13px;
}

/* Casilla de compra/venta: mismo aspecto que el stash, con una franja de precio abajo.
   El nombre deja libre ese espacio y la cantidad sube a la esquina de arriba. */
.item-slot.trade-slot {
    padding-bottom: 16px;
    position: relative;
}

.trade-slot .item-name {
    font-size: 13px;
}

.trade-slot .item-qty {
    top: 2px;
    bottom: auto;
    font-size: 12px;
}

.trade-price {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 16px;
    -unity-text-align: middle-center;
    background-color: rgba(6, 6, 10, 0.75);
    color: rgb(228, 183, 80);
    font-size: 12px;
    -unity-font-style: bold;
}

.trade-slot .glove-band {
    bottom: 16px; /* encima de la franja de precio */
}

.trade-slot--armed {
    border-color: rgb(228, 183, 80);
    border-width: 2px;
}

.trade-slot--armed .trade-price {
    background-color: rgba(228, 183, 80, 0.85);
    color: rgb(18, 19, 29);
}

.economy-status {
    margin-top: 8px;
    min-height: 20px;
    color: rgb(220, 110, 105);
    font-size: 14px;
}

.economy-status.economy-status--ok {
    color: rgb(200, 201, 212);
}

.economy-note {
    color: rgb(130, 132, 146);
    font-size: 14px;
    -unity-font-style: italic;
    margin: 12px 0;
}
