<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HUD.uss" />
    <Style src="Settings.uss" />
    <ui:VisualElement name="hud-root" class="hud-root">
        <ui:VisualElement name="danger-frame" class="danger-frame" />
        <ui:VisualElement name="damage-flash" class="damage-flash" />
        <ui:VisualElement name="damage-indicator" class="damage-indicator" />

        <ui:VisualElement name="run-info" class="run-info">
            <ui:Label name="run-timer" text="02:00" class="run-timer" />
            <ui:Label name="run-danger" text="Danger Phase" class="run-danger" />
            <ui:Label name="run-counter" text="Alive 0 · Extracted 0 · Dead 0" class="run-counter" />
        </ui:VisualElement>
        <ui:VisualElement name="extraction-container" class="extraction-container">
            <ui:Label name="extraction-label" text="Extracting..." class="extraction-label" />
            <ui:VisualElement name="extraction-bar-bg" class="extraction-bar-bg">
                <ui:VisualElement name="extraction-bar-fill" class="extraction-bar-fill" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="bars-container" class="bars-container">

            <ui:VisualElement name="health-bar-bg" class="bar-bg health-bar-bg">
                <ui:VisualElement name="health-bar-fill" class="bar-fill health-bar-fill" />
                <ui:Label name="health-text" text="100 / 100" class="bar-text" />
            </ui:VisualElement>

            <ui:VisualElement name="mana-bar-bg" class="bar-bg mana-bar-bg">
                <ui:VisualElement name="mana-bar-fill" class="bar-fill mana-bar-fill" />
                <ui:Label name="mana-text" text="100 / 100" class="bar-text" />
            </ui:VisualElement>

        </ui:VisualElement>
        <ui:VisualElement name="stat-modifiers" class="stat-modifiers" />
        <ui:VisualElement name="ability-bar" class="ability-bar">
            <ui:VisualElement name="slot-0" class="ability-slot">
                <ui:VisualElement class="ability-icon icon-circle icon-violet" />
                <ui:VisualElement name="slot-0-cd" class="slot-cooldown" />
                <ui:Label name="slot-0-cd-text" class="slot-cd-text" />
                <ui:Label name="slot-0-key" text="LMB" class="slot-key" />
            </ui:VisualElement>
            <ui:VisualElement name="slot-1" class="ability-slot">
                <ui:VisualElement class="ability-icon icon-diamond icon-green" />
                <ui:VisualElement name="slot-1-cd" class="slot-cooldown" />
                <ui:Label name="slot-1-cd-text" class="slot-cd-text" />
                <ui:Label name="slot-1-key" text="Shift" class="slot-key" />
            </ui:VisualElement>
            <ui:VisualElement name="slot-2" class="ability-slot">
                <ui:VisualElement name="slot-glove-icon" class="ability-icon icon-circle icon-gold" />
                <ui:Label name="slot-glove-name" text="No Glove" class="slot-name" />
                <ui:VisualElement name="slot-2-cd" class="slot-cooldown" />
                <ui:Label name="slot-2-cd-text" class="slot-cd-text" />
                <ui:Label name="slot-2-key" text="RMB" class="slot-key" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="interact-prompt" text="" class="interact-prompt" />
        <ui:VisualElement name="crosshair-container" class="crosshair-container">
            <ui:VisualElement name="cooldown-ring" class="cooldown-ring" />
            <ui:VisualElement name="crosshair" class="crosshair" />
            <ui:VisualElement name="hitmarker" class="hitmarker" />
        </ui:VisualElement>

        <ui:VisualElement name="dash-bar" class="dash-bar" picking-mode="Ignore">
            <ui:VisualElement name="dash-bar-fill" class="dash-bar-fill" />
        </ui:VisualElement>
        <ui:VisualElement name="flash-overlay" class="flash-overlay" picking-mode="Ignore" />

        <!-- Menú de pausa (Esc). La partida sigue: es solo un menú, no detiene el juego. -->
        <ui:VisualElement name="pause-root" class="pause-root">
            <ui:VisualElement class="pause-panel">
                <ui:Label text="Paused" class="pause-title" />
                <ui:Label text="The run keeps going while this menu is open." class="pause-hint" />

                <ui:ScrollView name="pause-settings" class="settings-scroll" />

                <ui:Button name="pause-resume" text="Resume" class="pause-button primary" />
                <ui:Button name="pause-leave" text="Leave Run" class="pause-button danger" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>