.hud-root {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Regular.ttf");
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 50px;
}

.danger-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 0px;
    border-color: rgba(255, 102, 97, 0.7);
    transition-property: border-width;
    transition-duration: 0.4s;
}

.danger-frame.active {
    border-width: 10px;
}

/* --- Extracción --- */
.extraction-container {
    position: absolute;
    top: 40%;
    width: 560px;
    align-items: center;
    display: none;
}

.extraction-label {
    color: rgb(237, 238, 245);
    -unity-font-style: bold;
    font-size: 28px;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
}

.extraction-bar-bg {
    width: 560px;
    height: 30px;
    background-color: rgba(20, 21, 30, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    overflow: hidden;
}

.extraction-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(228, 183, 80);
}

/* --- Barras vida / maná --- */
.bars-container {
    width: 480px;
    margin-bottom: 16px;
}

.bar-bg {
    width: 480px;
    background-color: rgba(20, 21, 30, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.health-bar-bg {
    height: 30px;
    margin-bottom: 7px;
}

.mana-bar-bg {
    height: 22px;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.health-bar-fill {
    background-color: rgb(226, 73, 71);
}

.mana-bar-fill {
    background-color: rgb(0, 171, 211);
}

.bar-text {
    color: rgb(237, 238, 245);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

/* --- Barra de habilidades --- */
.ability-bar {
    flex-direction: row;
}

.ability-slot {
    width: 84px;
    height: 84px;
    margin: 7px;
    background-color: rgba(20, 21, 30, 0.85);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    border-radius: 10px;
    justify-content: flex-end;
    align-items: flex-start;
    overflow: hidden;
    position: relative;
}

.ability-icon {
    position: absolute;
    top: 14px;
    left: 50%;
}

.icon-circle {
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border-radius: 8px;
}

.icon-diamond {
    width: 14px;
    height: 14px;
    margin-left: -7px;
    rotate: 45deg;
}

.icon-square {
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 3px;
}

.icon-violet { background-color: rgb(181, 139, 249); }
.icon-green  { background-color: rgb(103, 210, 131); }
.icon-gold   { background-color: rgb(228, 183, 80); }
.icon-cyan   { background-color: rgb(62, 204, 226); }

/* Color del ícono del slot del guante según su escuela (GloveSchool). */
.icon-gold.school-destruction { background-color: rgb(232, 112, 76); }
.icon-gold.school-restoration { background-color: rgb(103, 210, 131); }
.icon-gold.school-illusion    { background-color: rgb(196, 168, 255); }

/* Habilidad re-activable en vuelo (ej. detonar el orbe de destello): el slot se resalta. */
.ability-slot--recast {
    border-color: rgb(237, 238, 245);
    border-width: 2px;
}

/* Nombre de la habilidad del guante (o "No Glove"). */
.slot-name {
    position: absolute;
    top: 34px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    color: rgb(210, 211, 219);
    font-size: 11px;
    white-space: normal;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

/* Sin guante: slot apagado. */
.ability-slot--empty {
    opacity: 0.45;
}

.ability-slot--empty .ability-icon {
    background-color: rgb(90, 92, 108);
}

.slot-key {
    color: rgb(210, 211, 219);
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 7px;
    margin-bottom: 4px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.slot-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    background-color: rgba(4, 4, 9, 0.72);
    height: 0%;
}

.slot-cd-text {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    color: rgb(237, 238, 245);
    font-size: 18px;
    -unity-font-style: bold;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
    display: none;
}

/* --- Info de run --- */
.run-info {
    position: absolute;
    top: 26px;
    width: 100%;
    align-items: center;
}

.run-timer {
    color: rgb(237, 238, 245);
    -unity-font-style: bold;
    font-size: 42px;
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.95);
}

.run-danger {
    color: rgb(255, 102, 97);
    -unity-font-style: bold;
    font-size: 16px;
    letter-spacing: 2px;
    margin-top: 5px;
    display: none;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
}

.run-counter {
    color: rgb(220, 221, 229);
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 3px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.crosshair {
    width: 6px;
    height: 6px;
    background-color: rgba(237, 238, 245, 0.9);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(4, 4, 9, 0.7);
}

.interact-prompt {
    position: absolute;
    top: 55%;
    width: 100%;
    -unity-text-align: middle-center;
    color: rgb(237, 238, 245);
    -unity-font-style: bold;
    font-size: 19px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
    display: none;
}

.crosshair-container {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    justify-content: center;
    align-items: center;
}

.cooldown-ring {
    position: absolute;
    width: 40px;
    height: 40px;
}

/* Barrita del dash, debajo de la mira. */
.dash-bar {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 26px;
    height: 3px;
    margin-left: -13px;
    margin-top: 27px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    overflow: hidden;
}

.dash-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgba(103, 230, 255, 0.5);
}

.dash-bar-fill--ready {
    background-color: rgba(103, 230, 255, 0.95);
}

.hitmarker {
    position: absolute;
    width: 40px;
    height: 40px;
}

.stat-modifiers {
    position: absolute;
    top: 26px;
    right: 26px;
    align-items: flex-end;
}

.stat-modifier-entry {
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.stat-modifier-positive {
    color: rgb(80, 210, 100);
}

.stat-modifier-negative {
    color: rgb(240, 90, 88);
}

.damage-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 0px;
}

/* Destello (orbe de destello): blanco a pantalla completa, la opacidad la maneja FlashOverlay. */
.flash-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(255, 255, 255);
    opacity: 0;
    display: none;
}

.damage-indicator {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
/* ---------- Menú de pausa ---------- */

.pause-root {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(4, 4, 9, 0.72);
}

.pause-panel {
    width: 600px;
    padding: 30px 36px;
    background-color: rgba(14, 14, 24, 0.97);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    border-radius: 14px;
}

.pause-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Cinzel-Medium.ttf");
    font-size: 30px;
    color: rgb(243, 244, 252);
    -unity-text-align: upper-center;
}

.pause-hint {
    font-size: 14px;
    color: rgb(131, 133, 146);
    -unity-text-align: upper-center;
    margin-bottom: 18px;
}

.pause-slider {
    margin: 8px 0;
}

.pause-slider > .unity-label {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    color: rgb(200, 201, 212);
    font-size: 16px;
    min-width: 170px;
}

.pause-slider .unity-base-slider__tracker {
    background-color: rgba(60, 62, 80, 0.8);
    border-color: rgba(95, 98, 117, 0.6);
}

.pause-slider .unity-base-slider__dragger {
    background-color: rgb(186, 146, 253);
    border-color: rgb(186, 146, 253);
}

.pause-button {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    padding: 14px 20px;
    margin: 8px 0 0 0;
    border-width: 1px;
    border-radius: 10px;
    color: rgb(220, 221, 229);
    background-color: rgba(25, 26, 36, 0.6);
    border-color: rgba(95, 98, 117, 0.5);
}

.pause-button:hover {
    border-color: rgba(181, 139, 249, 0.6);
}

.pause-button.primary {
    margin-top: 20px;
    color: rgb(8, 8, 17);
    background-color: rgb(186, 146, 253);
    border-color: rgb(186, 146, 253);
}

.pause-button.danger {
    color: rgb(240, 110, 108);
    background-color: transparent;
    border-color: rgba(210, 70, 70, 0.5);
}

.pause-button.danger.armed {
    color: white;
    background-color: rgba(190, 50, 50, 0.9);
    border-color: rgb(230, 90, 90);
}

/* ---------- Números de daño ---------- */

.damage-number-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.damage-number {
    position: absolute;
    translate: -50% -50%;
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 236, 170);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
}

.damage-number.kill {
    font-size: 28px;
    color: rgb(255, 110, 100);
}

/* ---------- FPS / ping ---------- */

.net-stats {
    display: none;
    position: absolute;
    top: 12px;
    right: 16px;
    font-size: 14px;
    color: rgba(220, 221, 229, 0.85);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* ---------- Conexión inestable ---------- */

.connection-warning {
    position: absolute;
    top: 90px;
    left: 50%;
    translate: -50% 0;
    padding: 8px 18px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 210, 120);
    background-color: rgba(14, 14, 24, 0.85);
    border-width: 1px;
    border-color: rgba(255, 190, 90, 0.6);
    border-radius: 8px;
}
