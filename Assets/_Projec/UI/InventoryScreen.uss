.inv-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
}

.inv-panel {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Regular.ttf");
    flex-direction: column;
    background-color: rgb(14, 14, 24);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.4);
    border-radius: 18px;
    padding: 44px 44px;
}

.inv-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 26px;
}

.inv-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Cinzel-Medium.ttf");
    color: rgb(237, 238, 245);
    font-size: 33px;
}

.inv-hint-corner {
    color: rgb(97, 98, 111);
    font-size: 16px;
}

.inv-columns {
    flex-direction: row;
}

.column {
    margin: 0 16px;
}

.equipment-column {
    margin-left: 0;
}

.container-column {
    display: none; /* solo visible en modo saqueo */
}

.column-title {
    color: rgb(97, 98, 111);
    font-size: 18px;
    letter-spacing: 1px;
    margin-bottom: 12px;
}

/* ---------- Equipamiento ---------- */

.equipment-slots {
    flex-direction: column;
    width: 390px;
}

.equip-slot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(48, 49, 66, 0.25);
}

.equip-slot.no-border {
    border-bottom-width: 0;
}

.equip-slot-label {
    color: rgb(111, 113, 125);
    font-size: 20px;
    width: auto;
}

.equip-row-item {
    flex-direction: row;
    align-items: center;
}

.accent-dot {
    width: 12px;
    height: 12px;
    border-radius: 7px;
}

/* ---------- Pockets ---------- */

.pockets-and-usables {
    flex-direction: column;
}

.pockets-row {
    flex-direction: row;
}

.pocket-column {
    margin-right: 18px;
}

.backpack-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 336px; /* 4 slots por fila (68 + 2x8 de margen) */
}

.item-slot {
    width: 68px;
    height: 68px;
    margin: 8px;
    background-color: rgba(29, 30, 41, 0.4);
    border-width: 1px;
    border-color: rgba(55, 57, 74, 0.35);
    border-radius: 7px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.item-slot.locked {
    background-color: rgba(6, 6, 10, 0.7);
    border-color: rgba(30, 31, 40, 0.3);
    opacity: 0.3;
}

.item-slot:hover {
    border-color: rgba(237, 238, 245, 0.5);
}

.item-name {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    color: rgb(237, 238, 245);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    padding: 2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

.item-qty {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
}

/* ---------- Usables (placeholder visual, sin lógica todavía) ---------- */

.usable-slots {
    flex-direction: row;
    margin-top: 26px;
}

.usable-slot {
    width: 106px;
    height: 106px;
    margin: 8px;
    background-color: rgba(29, 30, 41, 0.4);
    border-width: 1px;
    border-color: rgba(55, 57, 74, 0.35);
    border-radius: 7px;
    position: relative;
}

.usable-key-hint {
    position: absolute;
    bottom: 5px;
    right: 7px;
    color: rgb(97, 98, 111);
    font-size: 14px;
}

/* ---------- Acentos por slot / tipo de item (igual que Stash) ---------- */

.accent-dot.accent-green   { background-color: rgb(103, 210, 131); }
.accent-dot.accent-cyan    { background-color: rgb(62, 204, 226); }
.accent-dot.accent-violet  { background-color: rgb(181, 139, 249); }
.accent-dot.accent-gold    { background-color: rgb(228, 183, 80); }
.accent-dot.accent-amber   { background-color: rgb(237, 131, 94); }
.accent-dot.accent-loot    { background-color: rgb(226, 73, 71); }

.item-slot.accent-green  { background-color: rgba(103, 210, 131, 0.14); }
.item-slot.accent-cyan   { background-color: rgba(62, 204, 226, 0.14); }
.item-slot.accent-violet { background-color: rgba(181, 139, 249, 0.14); }
.item-slot.accent-gold   { background-color: rgba(228, 183, 80, 0.14); }
.item-slot.accent-amber  { background-color: rgba(237, 131, 94, 0.14); }
.item-slot.accent-loot   { background-color: rgba(226, 73, 71, 0.14); }

/* ---------- Nombre de item dentro de una fila de equipo ---------- */

.equip-slot .equip-item-name {
    color: rgb(227, 228, 235);
    font-size: 19px;
    -unity-font-style: bold;
    margin-left: 9px;
}

.hint {
    color: rgb(97, 98, 111);
    font-size: 16px;
    -unity-font-style: italic;
    margin-top: 24px;
    -unity-text-align: middle-center;
}

.drag-ghost {
    position: absolute;
    width: 68px;
    height: 68px;
    background-color: rgba(40, 40, 60, 0.95);
    border-width: 1px;
    border-color: rgba(237, 238, 245, 0.6);
    border-radius: 7px;
    justify-content: center;
    align-items: center;
}

.item-tooltip {
    position: absolute;
    display: none;
    background-color: rgb(14, 14, 24);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    border-radius: 8px;
    padding: 12px 14px;
    max-width: 320px;
}

.tooltip-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    color: rgb(237, 238, 245);
    font-size: 17px;
    margin-bottom: 2px;
}

.tooltip-type {
    color: rgb(97, 98, 111);
    font-size: 13px;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.tooltip-description {
    color: rgb(180, 182, 192);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 6px;
}

.tooltip-stat-line {
    font-size: 14px;
    -unity-font-style: bold;
}

.container-column {
    border-left-width: 2px;
    border-left-color: rgba(226, 73, 71, 0.4);
    padding-left: 18px;
}

.container-title {
    color: rgb(240, 90, 88);
}

.tooltip-stat-positive { color: rgb(80, 210, 100); }
.tooltip-stat-negative { color: rgb(240, 90, 88); }
.tooltip-stat-neutral  { color: rgb(210, 211, 219); }
/* Rareza en TEXTO — solo donde no hay fondo tenue compitiendo (filas de Loadout, tooltip) */
.rarity-common { color: rgb(237, 238, 245); }
.rarity-rare   { color: rgb(90, 180, 255); }
.rarity-epic   { color: rgb(210, 110, 245); }

/* Rareza en BORDE — celdas de grilla, donde el texto de color no se leería bien */
.item-slot.rarity-rare {
    border-color: rgb(90, 180, 255);
    border-width: 2px;
}
.item-slot.rarity-epic {
    border-color: rgb(210, 110, 245);
    border-width: 2px;
}
/* ---------- Grupo "Bags" (pockets) en la lista de equipo ---------- */

.equip-group-header {
    color: rgb(150, 132, 190);
    font-size: 13px;
    letter-spacing: 1px;
    margin-top: 8px;
    padding-top: 8px;
    margin-bottom: 2px;
    border-top-width: 1px;
    border-top-color: rgba(181, 139, 249, 0.25);
}

.equip-slot.equip-slot-bag {
    padding: 5px 8px;
    margin-top: 3px;
    border-bottom-width: 0;
    border-radius: 6px;
    background-color: rgba(181, 139, 249, 0.06);
}

.equip-slot-bag .equip-slot-label {
    color: rgb(150, 132, 190);
}
